    "file": "Samples/OrComm.lean",
    "title": "Or, swapped",
    "blurb": "p ∨ q → q ∨ p by splitting on which side is true.",
    "watch": "rcases makes two branches with different hypotheses: hp in one, hq in the other.",
    "theorem": "or_comm (p q : Prop) : p ∨ q → q ∨ p",
    "leanVersion": "4.34.1"
  },
  "source": "namespace OrComm\n\ntheorem or_comm (p q : Prop) : p ∨ q → q ∨ p := by\n  intro h\n  rcases h with hp | hq\n  · apply Or.inr\n    exact hp\n  · apply Or.inl\n    exact hq\n\nend OrComm\n",
