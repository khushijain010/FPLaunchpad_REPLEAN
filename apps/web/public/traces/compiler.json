  "meta": {
    "id": "compiler",
    "file": "Samples/Compiler.lean",
    "category": "Programs",
    "title": "A tiny compiler, proved correct",
    "blurb": "Arithmetic expressions compiled to a stack machine, with a correctness proof.",
    "watch": "The add case uses both induction hypotheses, one rewrite each.",
    "theorem": "compile_correct (e : Expr) : exec (compile e) [] = [eval e]",
    "leanVersion": "4.34.1"
  },
  "source": "namespace Compiler\n\ninductive Expr where\n  | num : Nat → Expr\n  | add : Expr → Expr → Expr\n\ndef eval : Expr → Nat\n  | .num n   => n\n  | .add a b => eval a + eval b\n\ninductive Instr where\n  | push : Nat → Instr\n  | add  : Instr\n\ndef exec : List Instr → List Nat → List Nat\n  | [],            stk           => stk\n  | .push n :: rest, stk         => exec rest (n :: stk)\n  | .add :: rest,  y :: x :: stk => exec rest ((x + y) :: stk)\n  | .add :: _,     stk           => stk\n\ndef compile : Expr → List Instr\n  | .num n   => [.push n]\n  | .add a b => compile a ++ compile b ++ [.add]\n\ntheorem exec_compile (e : Expr) (rest : List Instr) (stk : List Nat) :\n    exec (compile e ++ rest) stk = exec rest (eval e :: stk) := by\n  induction e generalizing rest stk\n  case num n => rfl\n  case add a b iha ihb =>\n    simp only [compile, List.append_assoc]\n    rw [iha]\n    rw [ihb]\n    rfl\n\ntheorem compile_correct (e : Expr) : exec (compile e) [] = [eval e] := by\n  have h := exec_compile e [] []\n  rw [List.append_nil] at h\n  exact h\n\nend Compiler\n",
