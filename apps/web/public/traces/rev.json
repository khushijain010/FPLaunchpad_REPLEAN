    "file": "Samples/Rev.lean",
    "title": "Reversing [1, 2, 3]",
    "blurb": "A hand-rolled rev, unfolded one rewrite at a time.",
    "watch": "Open List Lab: each rw [rev] moves the head of the list to the back.",
    "theorem": "rev_123 : rev [1, 2, 3] = [3, 2, 1]",
    "leanVersion": "4.34.1"
  },
  "source": "namespace Rev\n\ndef app : List Nat → List Nat → List Nat\n  | [],      ys => ys\n  | x :: xs, ys => x :: app xs ys\n\ndef rev : List Nat → List Nat\n  | []      => []\n  | x :: xs => app (rev xs) [x]\n\ntheorem rev_123 : rev [1, 2, 3] = [3, 2, 1] := by\n  rw [rev]\n  rw [rev]\n  rw [rev]\n  rw [rev]\n  rw [app]\n  rw [app]\n  simp only [app]\n\nend Rev\n",
